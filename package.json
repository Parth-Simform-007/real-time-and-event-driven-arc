{
  "name": "ridewave",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:all": "nest build api-gateway && nest build user-service && nest build ride-service && nest build payment-service && nest build notification-service",
    "start:api-gateway": "nest start api-gateway",
    "start:user-service": "nest start user-service",
    "start:ride-service": "nest start ride-service",
    "start:payment-service": "nest start payment-service",
    "start:notification-service": "nest start notification-service",
    "start:dev:api-gateway": "nest start --watch api-gateway",
    "start:dev:user-service": "nest start --watch user-service",
    "start:dev:ride-service": "nest start --watch ride-service",
    "start:dev:payment-service": "nest start --watch payment-service",
    "start:dev:notification-service": "nest start --watch notification-service",
    "start:dev:all": "concurrently -n gateway,user,ride,payment,notif -c blue,green,magenta,yellow,cyan \"npm:start:dev:api-gateway\" \"npm:start:dev:user-service\" \"npm:start:dev:ride-service\" \"npm:start:dev:payment-service\" \"npm:start:dev:notification-service\"",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "format:check": "prettier --check \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js}": "prettier --write",
    "*.{json,md}": "prettier --write"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "amqplib": "^2.0.1",
    "axios": "^1.6.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.0.0",
    "@types/passport-jwt": "^3.0.13",
    "@types/uuid": "^9.0.7",
    "concurrently": "^10.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "ts-loader": "^9.6.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  }
}
