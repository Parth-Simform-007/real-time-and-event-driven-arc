# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Database — User Service
USER_DB_HOST=localhost
USER_DB_PORT=5432
USER_DB_NAME=ridewave_users
USER_DB_USER=postgres
USER_DB_PASS=postgres

# Database — Ride Service
RIDE_DB_HOST=localhost
RIDE_DB_PORT=5433
RIDE_DB_NAME=ridewave_rides
RIDE_DB_USER=postgres
RIDE_DB_PASS=postgres

# Database — Payment Service
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=5434
PAYMENT_DB_NAME=ridewave_payments
PAYMENT_DB_USER=postgres
PAYMENT_DB_PASS=postgres

# Database — Notification Service
NOTIFICATION_DB_HOST=localhost
NOTIFICATION_DB_PORT=5435
NOTIFICATION_DB_NAME=ridewave_notifications
NOTIFICATION_DB_USER=postgres
NOTIFICATION_DB_PASS=postgres

# Service URLs (used by API Gateway)
USER_SERVICE_URL=http://localhost:3001
RIDE_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
